#!/usr/bin/env sh
set -u

pr=${1:?usage: watch-pr <pr-url> [seconds]}
budget=${2:-540}
path=${pr#https://github.com/}
repo=$(printf '%s\n' "$path" | cut -d/ -f1-2)
num=$(printf '%s\n' "$path" | cut -d/ -f4)
start=$(date +%s)
since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
me=$(gh api user --jq .login)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
: > "$tmp/seen"
empty=0

comments() {
  gh api "repos/$repo/issues/$num/comments?since=$1" \
    --jq ".[] | select(.user.login != \"$me\") | \"comment \(.user.login) \(.html_url)\"" 2> /dev/null
  gh api "repos/$repo/pulls/$num/comments?since=$1" \
    --jq ".[] | select(.user.login != \"$me\") | \"comment \(.user.login) \(.html_url)\"" 2> /dev/null
  gh api "repos/$repo/pulls/$num/reviews" \
    --jq ".[] | select(.user.login != \"$me\" and .submitted_at >= \"$1\") | \"review \(.user.login) \(.html_url)\"" 2> /dev/null
}

while :; do
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  gh pr checks "$pr" --json name,bucket,link > "$tmp/checks" 2> /dev/null
  if [ ! -s "$tmp/checks" ] || [ "$(cat "$tmp/checks")" = "[]" ]; then
    empty=$((empty + 1))
    if [ "$empty" -ge 10 ]; then
      echo "no-checks"
      exit 0
    fi
  else
    jq -r '.[] | select(.bucket != "pending") | "check \(.bucket) \(.name) \(.link)"' "$tmp/checks" | sort > "$tmp/finished"
    comm -13 "$tmp/seen" "$tmp/finished" > "$tmp/new"
    cat "$tmp/new"
    mv "$tmp/finished" "$tmp/seen"
  fi
  comments "$since" > "$tmp/comments"
  cat "$tmp/comments"
  since=$now
  if [ -s "$tmp/checks" ] && jq -e 'length > 0 and all(.bucket != "pending")' "$tmp/checks" > /dev/null 2>&1; then
    echo "done"
    exit 0
  fi
  if [ -s "$tmp/comments" ] || grep -qE '^check (fail|cancel) ' "$tmp/new" 2> /dev/null; then
    echo "act"
    exit 0
  fi
  if [ $(($(date +%s) - start)) -ge "$budget" ]; then
    echo "pending"
    exit 0
  fi
  sleep 30
done
